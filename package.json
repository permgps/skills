{
  "name": "maestro-skills",
  "version": "0.0.2-alpha",
  "private": true,
  "type": "module",
  "description": "Maestro — an orchestrator skill that turns a dictated idea into a verified project",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "spec": "node scripts/validate/spec-integrity.ts docs/spec",
    "spec:scout": "node scripts/validate/spec-integrity.ts docs/spec/scout",
    "bundle": "node scripts/validate/bundle-integrity.ts skills/maestro",
    "bundle:scout": "node scripts/validate/bundle-integrity.ts skills/scout",
    "dashboard": "node scripts/validate/dashboard-integrity.ts skills/maestro/assets/dashboard.html docs/spec",
    "test": "node --test 'scripts/**/*.test.ts'",
    "check": "npm run typecheck && npm run spec && npm run spec:scout && npm run bundle && npm run bundle:scout && npm run dashboard && npm run state && npm run hosts && npm run doors && npm run dials && npm run view && npm run test",
    "link": "node scripts/package/link-local.ts link",
    "unlink": "node scripts/package/link-local.ts unlink",
    "state": "node scripts/validate/state-matches-spec.ts docs/spec",
    "hosts": "node scripts/validate/host-degradation.ts docs/spec skills/maestro",
    "doors": "node scripts/validate/repair-doors.ts docs/spec skills/maestro",
    "dials": "node scripts/validate/dials-defaults.ts docs/spec skills/maestro",
    "view": "node scripts/validate/viewer-ownership.ts skills/maestro",
    "metrics": "node scripts/metrics/measure.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
